; Godot 4 project - 20-table scene-first game
config_version=5

[application]
config/name="小森食堂 · 20桌营业"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="MoriDinerPrototype"

[display]
window/size/viewport_width=1536
window/size/viewport_height=1152
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.969, 0.949, 0.906, 1)
